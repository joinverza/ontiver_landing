{
  "name": "ontiver-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open --port 3001",
    "build": "node scripts/generate-seo-files.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write src scripts docs package.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check src scripts docs package.json vite.config.ts eslint.config.js",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run lint && npm run build && npm run verify:build"
  },
  "dependencies": {
    "@sentry/react": "^10.75.3",
    "@tailwindcss/vite": "^4.3.1",
    "lenis": "^1.3.24",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^25.9.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.12"
  }
}
